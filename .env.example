# Cloudflare R2 (galeria de vídeos na nuvem). Deixe em branco/omitido pra
# rodar só com armazenamento local (IndexedDB) + P2P, sem nuvem.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# URL pública do bucket (r2.dev ou domínio customizado), sem barra no final.
# Ex: https://pub-xxxxxxxxxxxx.r2.dev
R2_PUBLIC_BASE_URL=
